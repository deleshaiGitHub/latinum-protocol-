     * This is a safety mechanism - in normal operation, treasury keeps ratio healthy
     */
    function liquidate() external nonReentrant onlyKeeper {
        uint256 goldValue = _getGoldValue();
        uint256 currentLTV = (totalDebt * 100) / goldValue;
        
        // Only liquidate if LTV exceeds safe threshold
        if (currentLTV <= 80) return; // 80% LTV is liquidation trigger
        
        uint256 debtToCover = totalDebt;
        uint256 penalty = (debtToCover * liquidationPenalty) / 10000;
        uint256 goldToSell = _getGoldNeeded(debtToCover + penalty);
        
        // Withdraw gold from vault
        _withdrawGold(goldToSell);
        
        // Sell gold for stablecoins (via DEX)
        uint256 stablesReceived = _sellGoldForStables(goldToSell);
        
        if (stablesReceived >= debtToCover + penalty) {
            totalDebt = 0;
            uint256 surplus = stablesReceived - (debtToCover + penalty);
            if (surplus > 0) {
                stablecoin.transfer(msg.sender, surplus);
            }
        } else {
            // Partial liquidation
            totalDebt -= stablesReceived;
        }
        
        emit Liquidated(debtToCover, goldToSell, penalty);
    }
    
    // ---------- View Functions ----------
    
    function getHealthMetrics() external view returns (
        uint256 goldValueUSD,
        uint256 currentLTV,
        uint256 collateralRatio,
        uint256 maxBorrowAvailable,
        uint256 liquidationThreshold
    ) {
        goldValueUSD = _getGoldValue();
        if (totalDebt == 0) {
