// SPDX-License-Identifier: GPL-3.0
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/AccessControl.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/security/ReentrancyGuard.sol";
import "@openzeppelin/contracts/security/Pausable.sol";
import "@openzeppelin/contracts/utils/structs/EnumerableSet.sol";

/**
 * @title GoldRefinery
 * @notice Converts USDC into physical-gold-backed tokens (PAXG 70% / XAUt 30%)
 * @dev Part of Latinum Treasury System - feeds gold into GoldVault
 */
contract GoldRefinery is AccessControl, ReentrancyGuard, Pausable {
    using SafeERC20 for IERC20;
    using EnumerableSet for EnumerableSet.AddressSet;

    bytes32 public constant TREASURY_ROLE = keccak256("TREASURY_ROLE");
    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");

    // ---------- Constants (Ethereum Mainnet) ----------
    IERC20 public constant USDC = IERC20(0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eb48);
    IERC20 public constant PAXG = IERC20(0x45804880De22913dAFE09f4980848ECE6EcbAf78);
    IERC20 public constant XAUT = IERC20(0x68749665FF8D2d112Fa859AA293F07A622782F38);
    
    // DEX Router (Uniswap V3 SwapRouter02)
    address public constant SWAP_ROUTER = 0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45;
    
    // Fee tiers (Uniswap V3)
    uint24 public constant PAXG_USDC_FEE = 3000; // 0.3%
    uint24 public constant XAUT_USDC_FEE = 3000; // 0.3%
    
    // ---------- State ----------
    address public goldVault;
    uint256 public constant PAXG_RATIO = 70; // 70%
    uint256 public constant XAUT_RATIO = 30; // 30%
    uint256 public minSwapAmount = 1000 * 1e6; // $1000 USDC (6 decimals)
    uint256 public maxSlippageBps = 50; // 0.5% max slippage
    
    // For DCA functionality (if needed)
    uint256 public dcaInterval = 1 days;
    uint256 public lastRefinementTime;
    
    // Rate limiting
    uint256 public maxRefinementPerDay = 500000 * 1e6; // $500k USDC/day
    
    // Track daily usage
    uint256 public dailyRefinedAmount;
    uint256 public dailyResetTime;
    
    // ---------- Events ----------
    event GoldRefined(
        uint256 usdcAmount,
        uint256 paxgAmount,
        uint256 xautAmount,
        uint256 timestamp
    );
    event GoldVaultUpdated(address indexed newVault);
    event MinSwapAmountUpdated(uint256 newAmount);
    event MaxSlippageUpdated(uint256 newSlippage);
    event DCAIntervalUpdated(uint256 newInterval);
    event MaxRefinementUpdated(uint256 newMax);
    event EmergencyTokenRecovered(address token, uint256 amount);
    
    // ---------- Errors ----------
    error InsufficientAllowance();
    error BelowMinimumSwap();
    error ExceedsDailyLimit();
    error InvalidGoldVault();
    error SwapFailed();
    error SlippageTooHigh();
    error NotTreasury();
    error NotAdmin();
    
    // ---------- Constructor ----------
    constructor(address _goldVault, address _admin, address _treasury) {
        require(_goldVault != address(0), "Invalid gold vault");
        require(_admin != address(0), "Invalid admin");
        require(_treasury != address(0), "Invalid treasury");
        
        goldVault = _goldVault;
        dailyResetTime = block.timestamp;
        
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(TREASURY_ROLE, _treasury);
        _setRoleAdmin(ADMIN_ROLE, ADMIN_ROLE);
        _setRoleAdmin(TREASURY_ROLE, ADMIN_ROLE);
    }
    
    // ---------- Modifiers ----------
    modifier onlyTreasury() {
        if (!hasRole(TREASURY_ROLE, msg.sender)) revert NotTreasury();
        _;
    }
    
    modifier onlyAdmin() {
        if (!hasRole(ADMIN_ROLE, msg.sender)) revert NotAdmin();
        _;
    }
    
    // ---------- Core Functions ----------
    
    /**
     * @dev Convert USDC to gold and send to vault
     * @param usdcAmount Amount of USDC to convert
     */
    function refine(uint256 usdcAmount) 
        external 
        nonReentrant 
        whenNotPaused 
        onlyTreasury 
    {
        if (usdcAmount < minSwapAmount) revert BelowMinimumSwap();
        
        // Rate limiting
        _updateDailyLimit();
        if (dailyRefinedAmount + usdcAmount > maxRefinementPerDay) {
            revert ExceedsDailyLimit();
        }
        dailyRefinedAmount += usdcAmount;
        
        // Transfer USDC from treasury
        USDC.safeTransferFrom(msg.sender, address(this), usdcAmount);
        
        // Calculate split amounts
        uint256 paxgUsdc = (usdcAmount * PAXG_RATIO) / 100;
        uint256 xautUsdc = usdcAmount - paxgUsdc;
        
        // Execute swaps
        uint256 paxgReceived = _swapUsdcToGold(address(PAXG), paxgUsdc, PAXG_USDC_FEE);
        uint256 xautReceived = _swapUsdcToGold(address(XAUT), xautUsdc, XAUT_USDC_FEE);
        
        // Transfer gold to vault
        PAXG.safeTransfer(goldVault, paxgReceived);
        XAUT.safeTransfer(goldVault, xautReceived);
        
        emit GoldRefined(usdcAmount, paxgReceived, xautReceived, block.timestamp);
        lastRefinementTime = block.timestamp;
    }
    
    /**
     * @dev Internal swap using Uniswap V3
     */
    function _swapUsdcToGold(
        address tokenOut, 
        uint256 amountIn, 
        uint24 fee
    ) internal returns (uint256 amountOut) {
        if (amountIn == 0) return 0;
        
        // Approve router
        USDC.approve(SWAP_ROUTER, amountIn);
        
        // Calculate minimum output with slippage
        uint256 expectedOut = _getExpectedOutput(address(USDC), tokenOut, amountIn, fee);
        uint256 minOut = (expectedOut * (10000 - maxSlippageBps)) / 10000;
        
        // Uniswap V3 exact input single
        ISwapRouter.ExactInputSingleParams memory params = ISwapRouter.ExactInputSingleParams({
            tokenIn: address(USDC),
            tokenOut: tokenOut,
            fee: fee,
            recipient: address(this),
            deadline: block.timestamp + 300,
            amountIn: amountIn,
            amountOutMinimum: minOut,
            sqrtPriceLimitX96: 0
        });
        
        amountOut = ISwapRouter(SWAP_ROUTER).exactInputSingle(params);
        if (amountOut == 0) revert SwapFailed();
        
        return amountOut;
    }
    
    /**
     * @dev Get expected output from oracle (for slippage calculation)
     */
    function _getExpectedOutput(
        address tokenIn,
        address tokenOut,
        uint256 amountIn,
        uint24 fee
    ) internal view returns (uint256) {
        // Use Uniswap V3 quoter for accurate expectation
        // Address: 0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6
        bytes memory data = abi.encodeWithSignature(
            "quoteExactInputSingle(address,address,uint24,uint256,uint160)",
            tokenIn, tokenOut, fee, amountIn, 0
        );
        
        (bool success, bytes memory result) = 0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6.staticcall(data);
        if (!success) return amountIn; // Fallback to 1:1 estimate
        
        return abi.decode(result, (uint256));
    }
    
    // ---------- Admin Functions ----------
    
    function setGoldVault(address _newVault) external onlyAdmin {
        if (_newVault == address(0)) revert InvalidGoldVault();
        goldVault = _newVault;
        emit GoldVaultUpdated(_newVault);
    }
    
    function setMinSwapAmount(uint256 _newMin) external onlyAdmin {
        minSwapAmount = _newMin;
        emit MinSwapAmountUpdated(_newMin);
    }
    
    function setMaxSlippage(uint256 _newSlippageBps) external onlyAdmin {
        require(_newSlippageBps <= 500, "Slippage too high"); // Max 5%
        maxSlippageBps = _newSlippageBps;
        emit MaxSlippageUpdated(_newSlippageBps);
    }
    
    function setMaxRefinementPerDay(uint256 _newMax) external onlyAdmin {
        maxRefinementPerDay = _newMax;
        emit MaxRefinementUpdated(_newMax);
    }
    
    function setDCAInterval(uint256 _newInterval) external onlyAdmin {
        dcaInterval = _newInterval;
        emit DCAIntervalUpdated(_newInterval);
    }
    
    function pause() external onlyAdmin {
        _pause();
    }
    
    function unpause() external onlyAdmin {
        _unpause();
    }
    
    // ---------- Internal ----------
    
    function _updateDailyLimit() internal {
        if (block.timestamp >= dailyResetTime + 1 days) {
            dailyRefinedAmount = 0;
            dailyResetTime = block.timestamp;
        }
    }
    
    // ---------- Emergency ----------
    
    function recoverTokens(address token, uint256 amount) external onlyAdmin {
        IERC20(token).safeTransfer(msg.sender, amount);
        emit EmergencyTokenRecovered(token, amount);
    }
}

// Uniswap V3 Router Interface
interface ISwapRouter {
    struct ExactInputSingleParams {
        address tokenIn;
        address tokenOut;
        uint24 fee;
        address recipient;
        uint256 deadline;
        uint256 amountIn;
        uint256 amountOutMinimum;
        uint160 sqrtPriceLimitX96;
    }
    
    function exactInputSingle(ExactInputSingleParams calldata params) 
        external 
        returns (uint256 amountOut);
}
