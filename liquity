    event Repaid(uint256 amount, uint256 remainingDebt);
    event Liquidated(uint256 debtAmount, uint256 goldAmount, uint256 penalty);
    event ParametersUpdated(string indexed param, uint256 oldValue, uint256 newValue);
    event Paused(bool state);
    event GoldVaultUpdated(address indexed newVault);
    
    // ---------- Errors ----------
    error ProtocolPaused();
    error ExceedsMaxLTV();
    error BelowMinCollateralRatio();
    error InsufficientDebt();
    error InvalidAmount();
    error TransferFailed();
    error OracleFailed();
    error NotKeeper();
    error NotTreasury();
    error NotAdmin();
    
    // ---------- Constructor ----------
    constructor(address _goldVault, address _stablecoin, address _admin, address _treasury) {
        require(_goldVault != address(0), "Invalid gold vault");
        require(_stablecoin != address(0), "Invalid stablecoin");
        
        goldVault = _goldVault;
        stablecoin = IERC20(_stablecoin);
        
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(TREASURY_ROLE, _treasury);
        _setRoleAdmin(ADMIN_ROLE, ADMIN_ROLE);
        _setRoleAdmin(TREASURY_ROLE, ADMIN_ROLE);
        _setRoleAdmin(KEEPER_ROLE, ADMIN_ROLE);
    }
    
    // ---------- Modifiers ----------
    modifier onlyTreasury() {
        if (!hasRole(TREASURY_ROLE, msg.sender)) revert NotTreasury();
        _;
    }
    
    modifier onlyAdmin() {
        if (!hasRole(ADMIN_ROLE, msg.sender)) revert NotAdmin();
        _;
    }
    
    modifier onlyKeeper() {
        if (!hasRole(KEEPER_ROLE, msg.sender)) revert NotKeeper();
        _;
    }
    
    // ---------- Core Functions ----------
    
    /**
     * @dev Borrow stablecoins against gold collateral
     * @param amount Amount of stablecoin to borrow
     */
    function borrow(uint256 amount) 
        external 
        nonReentrant 
        whenNotPaused 
        onlyTreasury 
    {
        if (amount == 0) revert InvalidAmount();
        
        uint256 goldValue = _getGoldValue();
        uint256 newDebt = totalDebt + amount;
        
        // Enforce max LTV (25%)
        uint256 maxBorrow = (goldValue * maxLTV) / 100;
        if (newDebt > maxBorrow) revert ExceedsMaxLTV();
        
        // Enforce min collateral ratio (400%)
        uint256 newCollateralRatio = (goldValue * 100) / newDebt;
        if (newCollateralRatio < minCollateralRatio) revert BelowMinCollateralRatio();
        
        // Calculate fee (if any)
        uint256 fee = (amount * borrowingFee) / 10000;
        uint256 amountAfterFee = amount - fee;
        
        // Update state
        totalDebt = newDebt;
        totalFeesAccumulated += fee;
        lastBorrowTime = block.timestamp;
        totalBorrowEvents++;
        
        // Transfer stablecoin to treasury
        if (amountAfterFee > 0) {
            if (!stablecoin.transfer(msg.sender, amountAfterFee)) revert TransferFailed();
        }
        
        emit Borrowed(amount, fee, goldValue, (newDebt * 100) / goldValue);
    }
    
    /**
     * @dev Repay borrowed stablecoins
     * @param amount Amount to repay
     */
    function repay(uint256 amount) 
        external 
        nonReentrant 
        whenNotPaused 
        onlyTreasury 
    {
        if (amount == 0) revert InvalidAmount();
        if (amount > totalDebt) revert InsufficientDebt();
        
        // Transfer stablecoin from treasury
        if (!stablecoin.transferFrom(msg.sender, address(this), amount)) revert TransferFailed();
        
        totalDebt -= amount;
        totalRepayEvents++;
        
        emit Repaid(amount, totalDebt);
    }
    
    /**
