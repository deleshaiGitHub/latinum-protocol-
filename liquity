## Contract 3: InternalCDP.sol

The borrowing engine—modified Liquity-style but with admin controls.

```solidity
// SPDX-License-Identifier: GPL-3.0
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/security/ReentrancyGuard.sol";
import "@chainlink/contracts/src/v0.8/interfaces/AggregatorV3Interface.sol";

/**
 * @title InternalCDP
 * @notice Borrow stablecoins against gold collateral held in GoldVault
 * @dev Admin-controlled LTV, no public users, no Recovery Mode
 */
contract InternalCDP is Ownable, ReentrancyGuard {
    // ---------- Addresses ----------
    address public goldVault;
    IERC20 public stablecoin; // USDC or custom stable
    
    // ---------- Chainlink ----------
    AggregatorV3Interface public goldOracle; // Gold/USD oracle
    
    // ---------- Parameters (Admin Settable) ----------
    uint256 public maxLTV = 25; // 25% maximum loan-to-value
    uint256 public minCollateralRatio = 400; // 400% minimum (enforced at borrow)
    uint256 public borrowingFee = 0; // 0% for internal use (basis points, e.g., 50 = 0.5%)
    bool public paused = false;
    
    // ---------- State ----------
    uint256 public totalDebt; // Total stablecoin borrowed
    uint256 public totalFeesAccumulated; // Fees collected (if any)
    
    // ---------- Events ----------
    event Borrowed(uint256 amount, uint256 fee, uint256 timestamp);
    event Repaid(uint256 amount, uint256 timestamp);
    event ParametersUpdated(string param, uint256 oldValue, uint256 newValue);
    event Paused(bool state);
    
    // ---------- Constructor ----------
    constructor(address _goldVault, address _stablecoin, address _goldOracle) Ownable(msg.sender) {
        require(_goldVault != address(0), "Invalid gold vault");
        require(_stablecoin != address(0), "Invalid stablecoin");
        require(_goldOracle != address(0), "Invalid oracle");
        
        goldVault = _goldVault;
        stablecoin = IERC20(_stablecoin);
        goldOracle = AggregatorV3Interface(_goldOracle);
    }
    
    // ---------- Core Functions ----------
    
    /**
     * @dev Borrow stablecoins against gold collateral
     * @param amount Amount of stablecoin to borrow
     */
    function borrow(uint256 amount) external onlyOwner nonReentrant {
        require(!paused, "Protocol paused");
        require(amount > 0, "Amount must be > 0");
        
        uint256 goldValue = _getGoldValue();
        uint256 newDebt = totalDebt + amount;
        
        // Enforce max LTV (25%)
        uint256 maxBorrow = (goldValue * maxLTV) / 100;
        require(newDebt <= maxBorrow, "Exceeds max LTV");
        
        // Enforce min collateral ratio (400%)
        uint256 newCollateralRatio = (goldValue * 100) / newDebt;
        require(newCollateralRatio >= minCollateralRatio, "Below min collateral ratio");
        
        // Calculate fee (if any)
        uint256 fee = (amount * borrowingFee) / 10000;
        uint256 amountAfterFee = amount - fee;
        
        // Update state
        totalDebt = newDebt;
        totalFeesAccumulated += fee;
        
        // Transfer stablecoin to treasury
        require(stablecoin.transfer(msg.sender, amountAfterFee), "Stable transfer failed");
        
        emit Borrowed(amount, fee, block.timestamp);
    }
    
    /**
     * @dev Repay borrowed stablecoins
     * @param amount Amount to repay
     */
    function repay(uint256 amount) external onlyOwner nonReentrant {
        require(amount > 0, "Amount must be > 0");
        require(amount <= totalDebt, "Amount exceeds total debt");
        
        // Transfer stablecoin from treasury
        require(stablecoin.transferFrom(msg.sender, address(this), amount), "Transfer failed");
        
        totalDebt -= amount;
        
        emit Repaid(amount, block.timestamp);
    }
    
    /**
     * @dev Get current gold value from Chainlink and GoldVault holdings
     */
    function _getGoldValue() internal view returns (uint256) {
        // Query GoldVault for total USD value of gold holdings
        // We need to add a view function to GoldVault for this
        // For now, using a placeholder - you'll need to integrate with GoldVault
        
        // Option 1: Add getTotalGoldValue() to GoldVault and call it here
        // return IGoldVault(goldVault).getCurrentGoldValue();
        
        // Option 2: Calculate directly
        revert("Integration needed: call GoldVault.getCurrentGoldValue()");
    }
    
    /**
     * @dev Get current health metrics
     */
    function getHealthMetrics() external view returns (
        uint256 goldValueUSD,
        uint256 currentLTV,
        uint256 collateralRatio,
        uint256 maxBorrowAvailable
    ) {
        goldValueUSD = _getGoldValue();
        if (totalDebt == 0) {
            return (goldValueUSD, 0, type(uint256).max, (goldValueUSD * maxLTV) / 100);
        }
        
        currentLTV = (totalDebt * 100) / goldValueUSD;
        collateralRatio = (goldValueUSD * 100) / totalDebt;
        maxBorrowAvailable = ((goldValueUSD * maxLTV) / 100) - totalDebt;
    }
    
    // ---------- Admin Functions ----------
    
    function setMaxLTV(uint256 newLTV) external onlyOwner {
        require(newLTV > 0 && newLTV <= 50, "LTV must be between 1-50%");
        uint256 old = maxLTV;
        maxLTV = newLTV;
        emit ParametersUpdated("maxLTV", old, newLTV);
    }
    
    function setMinCollateralRatio(uint256 newRatio) external onlyOwner {
        require(newRatio >= 200, "Min ratio must be >= 200%");
        uint256 old = minCollateralRatio;
        minCollateralRatio = newRatio;
        emit ParametersUpdated("minCollateralRatio", old, newRatio);
    }
    
    function setBorrowingFee(uint256 newFee) external onlyOwner {
        require(newFee <= 500, "Fee cannot exceed 5%"); // Max 500 bps = 5%
        uint256 old = borrowingFee;
        borrowingFee = newFee;
        emit ParametersUpdated("borrowingFee", old, newFee);
    }
    
    function setPaused(bool _paused) external onlyOwner {
        paused = _paused;
        emit Paused(_paused);
    }
    
    /**
     * @dev Withdraw accumulated fees (if any)
     */
    function withdrawFees() external onlyOwner {
        uint256 amount = totalFeesAccumulated;
        require(amount > 0, "No fees to withdraw");
        totalFeesAccumulated = 0;
        require(stablecoin.transfer(owner(), amount), "Transfer failed");
    }
}
