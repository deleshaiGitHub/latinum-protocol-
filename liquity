## Contract 2: GoldVault.sol

The one-way valve that holds gold securely.

```solidity
// SPDX-License-Identifier: GPL-3.0
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@chainlink/contracts/src/v0.8/interfaces/AggregatorV3Interface.sol";

/**
 * @title GoldVault
 * @notice Holds treasury gold assets with one-way valve logic
 * @dev Gold can only be withdrawn for buybacks via authorized CDP contract
 */
contract GoldVault is Ownable {
    // ---------- Gold Tokens ----------
    IERC20 public constant PAXG = IERC20(0x...); // TODO: Add PAXG address
    IERC20 public constant XAUT = IERC20(0x...); // TODO: Add XAUt address
    
    // ---------- Chainlink Oracles ----------
    AggregatorV3Interface public paxgOracle; // PAXG/USD
    AggregatorV3Interface public xautOracle; // XAUt/USD
    
    // ---------- State ----------
    address public internalCDP; // Only this contract can withdraw for buybacks
    uint256 public totalGoldValueUSD; // Cached total value
    uint256 public lastUpdateTime;
    
    struct GoldHolding {
        uint256 paxgAmount;
        uint256 xautAmount;
    }
    
    GoldHolding public holdings;
    
    // ---------- Events ----------
    event GoldDeposited(address indexed asset, uint256 amount);
    event GoldWithdrawn(address indexed asset, uint256 amount, string reason);
    event InternalCDPSet(address indexed cdp);
    event GoldValueUpdated(uint256 totalValueUSD);
    
    // ---------- Modifiers ----------
    modifier onlyCDP() {
        require(msg.sender == internalCDP, "Only CDP can withdraw");
        _;
    }
    
    // ---------- Constructor ----------
    constructor(address _paxgOracle, address _xautOracle) Ownable(msg.sender) {
        require(_paxgOracle != address(0), "Invalid PAXG oracle");
        require(_xautOracle != address(0), "Invalid XAUt oracle");
        paxgOracle = AggregatorV3Interface(_paxgOracle);
        xautOracle = AggregatorV3Interface(_xautOracle);
    }
    
    // ---------- Deposit Functions ----------
    
    /**
     * @dev Deposit PAXG into vault
     */
    function depositPAXG(uint256 amount) external onlyOwner {
        require(amount > 0, "Amount must be > 0");
        PAXG.transferFrom(msg.sender, address(this), amount);
        holdings.paxgAmount += amount;
        _updateGoldValue();
        emit GoldDeposited(address(PAXG), amount);
    }
    
    /**
     * @dev Deposit XAUt into vault
     */
    function depositXAUt(uint256 amount) external onlyOwner {
        require(amount > 0, "Amount must be > 0");
        XAUT.transferFrom(msg.sender, address(this), amount);
        holdings.xautAmount += amount;
        _updateGoldValue();
        emit GoldDeposited(address(XAUT), amount);
    }
    
    // ---------- Withdrawal (Restricted) ----------
    
    /**
     * @dev Withdraw gold for buybacks only (called by CDP)
     */
    function withdrawForBuyback(address asset, uint256 amount) external onlyCDP nonReentrant {
        require(amount > 0, "Amount must be > 0");
        require(asset == address(PAXG) || asset == address(XAUT), "Invalid asset");
        
        IERC20 token = IERC20(asset);
        require(token.balanceOf(address(this)) >= amount, "Insufficient balance");
        
        token.transfer(internalCDP, amount);
        
        if (asset == address(PAXG)) {
            holdings.paxgAmount -= amount;
        } else {
            holdings.xautAmount -= amount;
        }
        
        _updateGoldValue();
        emit GoldWithdrawn(asset, amount, "buyback");
    }
    
    // ---------- Value Tracking ----------
    
    /**
     * @dev Update total gold value in USD using Chainlink oracles
     */
    function _updateGoldValue() internal {
        uint256 paxgValue = _getGoldValue(address(PAXG), holdings.paxgAmount);
        uint256 xautValue = _getGoldValue(address(XAUT), holdings.xautAmount);
        totalGoldValueUSD = paxgValue + xautValue;
        lastUpdateTime = block.timestamp;
        emit GoldValueUpdated(totalGoldValueUSD);
    }
    
    /**
     * @dev Get USD value of gold holdings using Chainlink
     */
    function _getGoldValue(address asset, uint256 amount) internal view returns (uint256) {
        if (amount == 0) return 0;
        
        AggregatorV3Interface oracle = (asset == address(PAXG)) ? paxgOracle : xautOracle;
        (, int256 price, , , ) = oracle.latestRoundData();
        require(price > 0, "Invalid oracle price");
        
        // PAXG/XAUt have 18 decimals, Chainlink price has 8 decimals
        // Result is in USD with 18 decimals
        return (amount * uint256(price)) / 1e8;
    }
    
    /**
     * @dev Public view to get current gold value
     */
    function getCurrentGoldValue() external view returns (uint256) {
        uint256 paxgValue = _getGoldValue(address(PAXG), holdings.paxgAmount);
        uint256 xautValue = _getGoldValue(address(XAUT), holdings.xautAmount);
        return paxgValue + xautValue;
    }
    
    // ---------- Admin Functions ----------
    
    function setInternalCDP(address _cdp) external onlyOwner {
        require(_cdp != address(0), "Invalid CDP address");
        internalCDP = _cdp;
        emit InternalCDPSet(_cdp);
    }
    
    // ---------- Emergency ----------
    
    /**
     * @dev Emergency recovery (only owner, with timelock in production)
     */
    function emergencyWithdraw(address token, uint256 amount) external onlyOwner {
        // In production, add timelock controller here
        IERC20(token).transfer(owner(), amount);
    }
}
