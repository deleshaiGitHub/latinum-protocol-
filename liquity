        }
        
        currentLTV = (totalDebt * 100) / goldValueUSD;
        collateralRatio = (goldValueUSD * 100) / totalDebt;
        maxBorrowAvailable = ((goldValueUSD * maxLTV) / 100) - totalDebt;
        liquidationThreshold = (goldValueUSD * 80) / 100; // 80% LTV liquidation threshold
    }
    
    function _getGoldValue() internal view returns (uint256) {
        // Call GoldVault to get current gold value
        return IGoldVault(goldVault).getCurrentGoldValue();
    }
    
    function _getGoldNeeded(uint256 stableAmount) internal view returns (uint256) {
        uint256 goldPrice = _getGoldPrice();
        // Returns gold amount with 18 decimals
        return (stableAmount * 1e8) / goldPrice;
    }
    
    function _getGoldPrice() internal view returns (uint256) {
        (, int256 price, , uint256 updatedAt, ) = GOLD_ORACLE.latestRoundData();
        if (price <= 0) revert OracleFailed();
        if (updatedAt < block.timestamp - 2 hours) revert OracleFailed();
        return uint256(price);
