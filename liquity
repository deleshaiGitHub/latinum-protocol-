        uint256 xautReceived = _swapUsdcToGold(address(XAUT), xautUsdc, XAUT_USDC_FEE);
        
        // Transfer gold to vault
        PAXG.safeTransfer(goldVault, paxgReceived);
        XAUT.safeTransfer(goldVault, xautReceived);
        
        emit GoldRefined(usdcAmount, paxgReceived, xautReceived, block.timestamp);
        lastRefinementTime = block.timestamp;
    }
    
    /**
     * @dev Internal swap using Uniswap V3
     */
    function _swapUsdcToGold(
        address tokenOut, 
        uint256 amountIn, 
        uint24 fee
    ) internal returns (uint256 amountOut) {
        if (amountIn == 0) return 0;
        
        // Approve router
        USDC.approve(SWAP_ROUTER, amountIn);
        
        // Calculate minimum output with slippage
        uint256 expectedOut = _getExpectedOutput(address(USDC), tokenOut, amountIn, fee);
        uint256 minOut = (expectedOut * (10000 - maxSlippageBps)) / 10000;
        
        // Uniswap V3 exact input single
        ISwapRouter.ExactInputSingleParams memory params = ISwapRouter.ExactInputSingleParams({
            tokenIn: address(USDC),
            tokenOut: tokenOut,
            fee: fee,
            recipient: address(this),
            deadline: block.timestamp + 300,
            amountIn: amountIn,
            amountOutMinimum: minOut,
            sqrtPriceLimitX96: 0
        });
        
        amountOut = ISwapRouter(SWAP_ROUTER).exactInputSingle(params);
        if (amountOut == 0) revert SwapFailed();
        
        return amountOut;
    }
    
    /**
     * @dev Get expected output from oracle (for slippage calculation)
     */
    function _getExpectedOutput(
        address tokenIn,
        address tokenOut,
        uint256 amountIn,
        uint24 fee
    ) internal view returns (uint256) {
        // Use Uniswap V3 quoter for accurate expectation
        // Address: 0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6
        bytes memory data = abi.encodeWithSignature(
            "quoteExactInputSingle(address,address,uint24,uint256,uint160)",
            tokenIn, tokenOut, fee, amountIn, 0
        );
        
        (bool success, bytes memory result) = 0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6.staticcall(data);
        if (!success) return amountIn; // Fallback to 1:1 estimate
        
        return abi.decode(result, (uint256));
    }
    
    // ---------- Admin Functions ----------
    
    function setGoldVault(address _newVault) external onlyAdmin {
        if (_newVault == address(0)) revert InvalidGoldVault();
        goldVault = _newVault;
        emit GoldVaultUpdated(_newVault);
    }
    
    function setMinSwapAmount(uint256 _newMin) external onlyAdmin {
        minSwapAmount = _newMin;
        emit MinSwapAmountUpdated(_newMin);
    }
    
    function setMaxSlippage(uint256 _newSlippageBps) external onlyAdmin {
        require(_newSlippageBps <= 500, "Slippage too high"); // Max 5%
        maxSlippageBps = _newSlippageBps;
        emit MaxSlippageUpdated(_newSlippageBps);
    }
    
    function setMaxRefinementPerDay(uint256 _newMax) external onlyAdmin {
        maxRefinementPerDay = _newMax;
        emit MaxRefinementUpdated(_newMax);
    }
    
    function setDCAInterval(uint256 _newInterval) external onlyAdmin {
        dcaInterval = _newInterval;
        emit DCAIntervalUpdated(_newInterval);
    }
    
    function pause() external onlyAdmin {
        _pause();
    }
    
    function unpause() external onlyAdmin {
        _unpause();
    }
    
    // ---------- Internal ----------
    
    function _updateDailyLimit() internal {
        if (block.timestamp >= dailyResetTime + 1 days) {
            dailyRefinedAmount = 0;
            dailyResetTime = block.timestamp;
        }
    }
    
    // ---------- Emergency ----------
    
    function recoverTokens(address token, uint256 amount) external onlyAdmin {
        IERC20(token).safeTransfer(msg.sender, amount);
        emit EmergencyTokenRecovered(token, amount);
    }
}

