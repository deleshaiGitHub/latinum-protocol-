        totalDebt = _getTotalDebt();
        netAssetValue = totalGoldUSD > totalDebt ? totalGoldUSD - totalDebt : 0;
        
        gplTotalSupply = IERC20(GPL_TOKEN).totalSupply();
        
        if (gplTotalSupply > 0) {
            backingPerGPL = (totalGoldUSD * 1e18) / gplTotalSupply;
        }
        
        if (totalGoldUSD > 0) {
            currentLTV = (totalDebt * 100) / totalGoldUSD;
            collateralRatio = (totalGoldUSD * 100) / totalDebt;
        }
    }
    
    /**
     * @dev Get gold vault breakdown
     */
    function getGoldBreakdown() external view returns (
        uint256 paxgValue,
        uint256 xautValue,
        uint256 totalValue
    ) {
        (paxgValue, xautValue, totalValue) = IGoldVault(GOLD_VAULT).getGoldValueBreakdown();
    }
    
    /**
     * @dev Get CDP health metrics
     */
    function getCDPMetrics() external view returns (
        uint256 goldValueUSD,
        uint256 currentLTV,
        uint256 collateralRatio,
        uint256 maxBorrowAvailable,
        uint256 liquidationThreshold
    ) {
        return IInternalCDP(INTERNAL_CDP).getHealthMetrics();
    }
    
    // ---------- Internal ----------
    
    function _getTotalGoldUSD() internal view returns (uint256) {
        return IGoldVault(GOLD_VAULT).getCurrentGoldValue();
    }
    
    function _getTotalDebt() internal view returns (uint256) {
        return IInternalCDP(INTERNAL_CDP).totalDebt();
    }
}

interface IGoldVault {
    function getCurrentGoldValue() external view returns (uint256);
    function getGoldValueBreakdown() external view returns (uint256 paxgValue, uint256 xautValue, uint256 total);
}

interface IInternalCDP {
    function totalDebt() external view returns (uint256);
    function getHealthMetrics() external view returns (uint256, uint256, uint256, uint256, uint256);
}
