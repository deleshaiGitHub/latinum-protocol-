    function refine(uint256 usdcAmount) external onlyOwner nonReentrant {
        require(usdcAmount >= minSwapAmount, "Amount below minimum");
        
        // Transfer USDC from caller (treasury) to this contract
        require(IERC20(USDC).transferFrom(msg.sender, address(this), usdcAmount), "USDC transfer failed");
        
