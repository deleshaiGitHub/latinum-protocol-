import "@chainlink/contracts/src/v0.8/interfaces/AggregatorV3Interface.sol";

/**
 * @title GoldVault
 * @notice Secure custody for treasury gold with one-way valve
 * @dev Part of Latinum Treasury System - holds PAXG and XAUt
 */
contract GoldVault is AccessControl, ReentrancyGuard, Pausable {
    using SafeERC20 for IERC20;

    bytes32 public constant TREASURY_ROLE = keccak256("TREASURY_ROLE");
    bytes32 public constant CDP_ROLE = keccak256("CDP_ROLE");
    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");

    // ---------- Constants ----------
    IERC20 public constant PAXG = IERC20(0x45804880De22913dAFE09f4980848ECE6EcbAf78);
    IERC20 public constant XAUT = IERC20(0x68749665FF8D2d112Fa859AA293F07A622782F38);
    
    // Chainlink Oracles (Ethereum Mainnet)
    AggregatorV3Interface public constant PAXG_ORACLE = AggregatorV3Interface(0x7B7B87e9bC0F2a12D9A7cE045B19F84d17b80A54);
    AggregatorV3Interface public constant XAUT_ORACLE = AggregatorV3Interface(0x85E847eB303A9f3Fb199aB92655C439d52a30bA3);
    
    // ---------- State ----------
    struct GoldHolding {
        uint256 paxgAmount;
        uint256 xautAmount;
        uint256 lastUpdateTime;
    }
    
    GoldHolding public holdings;
    uint256 public totalGoldValueUSD; // Cached with 18 decimals
    
    address public internalCDP;
    
    // For buyback mechanism
    uint256 public buybackThresholdBps = 500; // 5% discount triggers buyback
    bool public buybackEnabled = false;
    
    // ---------- Events ----------
    event GoldDeposited(address indexed asset, uint256 amount);
    event GoldWithdrawn(address indexed asset, uint256 amount, string reason);
    event InternalCDPSet(address indexed cdp);
    event GoldValueUpdated(uint256 totalValueUSD);
    event BuybackTriggered(uint256 gplPrice, uint256 floorPrice);
    event EmergencyWithdrawal(address indexed token, uint256 amount);
    
    // ---------- Errors ----------
    error UnauthorizedWithdrawal();
    error InsufficientBalance();
    error InvalidAddress();
    error OracleFailed();
    error BuybackNotEnabled();
    error FloorNotBreached();
    
    // ---------- Constructor ----------
    constructor(address _admin, address _treasury) {
        require(_admin != address(0), "Invalid admin");
        require(_treasury != address(0), "Invalid treasury");
        
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(TREASURY_ROLE, _treasury);
        _setRoleAdmin(ADMIN_ROLE, ADMIN_ROLE);
        _setRoleAdmin(TREASURY_ROLE, ADMIN_ROLE);
        _setRoleAdmin(CDP_ROLE, ADMIN_ROLE);
    }
    
    // ---------- Modifiers ----------
    modifier onlyTreasury() {
        if (!hasRole(TREASURY_ROLE, msg.sender)) revert UnauthorizedWithdrawal();
        _;
    }
    
    modifier onlyCDP() {
        if (msg.sender != internalCDP) revert UnauthorizedWithdrawal();
        _;
    }
    
    modifier onlyAdmin() {
        if (!hasRole(ADMIN_ROLE, msg.sender)) revert UnauthorizedWithdrawal();
        _;
    }
    
    // ---------- Deposit Functions ----------
    
    function depositPAXG(uint256 amount) external nonReentrant whenNotPaused onlyTreasury {
        require(amount > 0, "Amount must be > 0");
        
        PAXG.safeTransferFrom(msg.sender, address(this), amount);
        holdings.paxgAmount += amount;
        
        _updateGoldValue();
        emit GoldDeposited(address(PAXG), amount);
    }
    
    function depositXAUt(uint256 amount) external nonReentrant whenNotPaused onlyTreasury {
        require(amount > 0, "Amount must be > 0");
        
        XAUT.safeTransferFrom(msg.sender, address(this), amount);
        holdings.xautAmount += amount;
        
        _updateGoldValue();
        emit GoldDeposited(address(XAUT), amount);
    }
    
    // ---------- Withdrawal (Restricted) ----------
    
    function withdrawForBuyback(address asset, uint256 amount) 
        external 
        nonReentrant 
        onlyCDP 
    {
        if (!buybackEnabled) revert BuybackNotEnabled();
        require(amount > 0, "Amount must be > 0");
        require(asset == address(PAXG) || asset == address(XAUT), "Invalid asset");
        
        IERC20 token = IERC20(asset);
        uint256 balance = token.balanceOf(address(this));
        if (balance < amount) revert InsufficientBalance();
        
        token.safeTransfer(internalCDP, amount);
        
        if (asset == address(PAXG)) {
            holdings.paxgAmount -= amount;
        } else {
            holdings.xautAmount -= amount;
        }
        
        _updateGoldValue();
        emit GoldWithdrawn(asset, amount, "buyback");
    }
    
    // ---------- Value Tracking ----------
    
    function getCurrentGoldValue() public view returns (uint256) {
        return _getGoldValue(address(PAXG), holdings.paxgAmount) + 
               _getGoldValue(address(XAUT), holdings.xautAmount);
    }
    
    function getGoldValueBreakdown() external view returns (
        uint256 paxgValue,
        uint256 xautValue,
        uint256 paxgPrice,
        uint256 xautPrice,
        uint256 total
    ) {
        paxgPrice = _getLatestPrice(address(PAXG_ORACLE));
        xautPrice = _getLatestPrice(address(XAUT_ORACLE));
        
        paxgValue = (holdings.paxgAmount * paxgPrice) / 1e8;
        xautValue = (holdings.xautAmount * xautPrice) / 1e8;
        total = paxgValue + xautValue;
    }
    
    function _updateGoldValue() internal {
        totalGoldValueUSD = getCurrentGoldValue();
        holdings.lastUpdateTime = block.timestamp;
        emit GoldValueUpdated(totalGoldValueUSD);
    }
    
    function _getGoldValue(address asset, uint256 amount) internal view returns (uint256) {
        if (amount == 0) return 0;
        
        AggregatorV3Interface oracle = (asset == address(PAXG)) ? PAXG_ORACLE : XAUT_ORACLE;
        uint256 price = _getLatestPrice(address(oracle));
        
        // PAXG/XAUt have 18 decimals, Chainlink price has 8 decimals
        // Result is in USD with 18 decimals
        return (amount * price) / 1e8;
    }
    
    function _getLatestPrice(address oracle) internal view returns (uint256) {
        (, int256 price, , uint256 updatedAt, ) = AggregatorV3Interface(oracle).latestRoundData();
        
        if (price <= 0) revert OracleFailed();
        if (updatedAt < block.timestamp - 2 hours) revert OracleFailed();
        
        return uint256(price);
    }
    
    // ---------- Buyback Logic ----------
    
    function checkBuybackTrigger(uint256 gplMarketPrice, uint256 gplFloorPrice) 
        external 
        view 
        returns (bool shouldTrigger, uint256 discountBps) 
    {
        if (!buybackEnabled) return (false, 0);
        if (gplFloorPrice == 0) return (false, 0);
        
        if (gplMarketPrice < gplFloorPrice) {
            discountBps = ((gplFloorPrice - gplMarketPrice) * 10000) / gplFloorPrice;
            shouldTrigger = discountBps >= buybackThresholdBps;
        }
    }
    
    // ---------- Admin Functions ----------
    
    function setInternalCDP(address _cdp) external onlyAdmin {
        if (_cdp == address(0)) revert InvalidAddress();
        internalCDP = _cdp;
        _grantRole(CDP_ROLE, _cdp);
        emit InternalCDPSet(_cdp);
    }
    
    function setBuybackEnabled(bool _enabled) external onlyAdmin {
        buybackEnabled = _enabled;
    }
    
    function setBuybackThreshold(uint256 _thresholdBps) external onlyAdmin {
        require(_thresholdBps <= 2000, "Threshold too high"); // Max 20%
        buybackThresholdBps = _thresholdBps;
    }
    
    function pause() external onlyAdmin {
        _pause();
    }
    
    function unpause() external onlyAdmin {
        _unpause();
    }
    
    // ---------- Emergency ----------
    
    function emergencyWithdraw(address token, uint256 amount) external onlyAdmin {
        IERC20(token).safeTransfer(msg.sender, amount);
        emit EmergencyWithdrawal(token, amount);
    }
}
