    uint256 public constant XAUT_RATIO = 30; // 30% to XAUt
    uint256 public minSwapAmount = 100 * 1e6; // $100 minimum (USDC has 6 decimals)
    
    // ---------- Events ----------
    event GoldRefined(uint256 usdcAmount, uint256 paxgAmount, uint256 xautAmount);
    event DexAggregatorUpdated(address indexed newAggregator);
    event MinSwapAmountUpdated(uint256 newAmount);
    
    // ---------- Constructor ----------
