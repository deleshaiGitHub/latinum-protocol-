contract InternalCDP is AccessControl, ReentrancyGuard, Pausable {
    using SafeERC20 for IERC20;

    bytes32 public constant TREASURY_ROLE = keccak256("TREASURY_ROLE");
    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");
    bytes32 public constant KEEPER_ROLE = keccak256("KEEPER_ROLE");

    // ---------- Addresses ----------
    address public goldVault;
    IERC20 public stablecoin;
    
    // Chainlink Gold Oracle (XAU/USD)
    AggregatorV3Interface public constant GOLD_ORACLE = AggregatorV3Interface(0x3C065EA6FcCb5C1F28E5E953285F55F99ABBEeC5);
    
    // ---------- Parameters ----------
    uint256 public maxLTV = 25; // 25% maximum loan-to-value
    uint256 public minCollateralRatio = 400; // 400% minimum (enforced at borrow)
    uint256 public borrowingFee = 0; // 0% for internal use (basis points)
    uint256 public liquidationPenalty = 500; // 5% penalty on liquidation
    
    // ---------- State ----------
    uint256 public totalDebt; // Total stablecoin borrowed
    uint256 public totalFeesAccumulated;
    uint256 public lastBorrowTime;
    
    // For tracking
    uint256 public totalBorrowEvents;
    uint256 public totalRepayEvents;
    
    // ---------- Events ----------
    event Borrowed(uint256 amount, uint256 fee, uint256 collateralValue, uint256 newLTV);
    event Repaid(uint256 amount, uint256 remainingDebt);
    event Liquidated(uint256 debtAmount, uint256 goldAmount, uint256 penalty);
    event ParametersUpdated(string indexed param, uint256 oldValue, uint256 newValue);
    event Paused(bool state);
    event GoldVaultUpdated(address indexed newVault);
    
    // ---------- Errors ----------
    error ProtocolPaused();
    error ExceedsMaxLTV();
    error BelowMinCollateralRatio();
    error InsufficientDebt();
    error InvalidAmount();
    error TransferFailed();
    error OracleFailed();
    error NotKeeper();
    error NotTreasury();
    error NotAdmin();
    
    // ---------- Constructor ----------
    constructor(address _goldVault, address _stablecoin, address _admin, address _treasury) {
        require(_goldVault != address(0), "Invalid gold vault");
        require(_stablecoin != address(0), "Invalid stablecoin");
        
        goldVault = _goldVault;
        stablecoin = IERC20(_stablecoin);
        
        _grantRole(ADMIN_ROLE, _admin);
        _grantRole(TREASURY_ROLE, _treasury);
        _setRoleAdmin(ADMIN_ROLE, ADMIN_ROLE);
        _setRoleAdmin(TREASURY_ROLE, ADMIN_ROLE);
        _setRoleAdmin(KEEPER_ROLE, ADMIN_ROLE);
    }
    
    // ---------- Modifiers ----------
    modifier onlyTreasury() {
        if (!hasRole(TREASURY_ROLE, msg.sender)) revert NotTreasury();
        _;
    }
    
    modifier onlyAdmin() {
        if (!hasRole(ADMIN_ROLE, msg.sender)) revert NotAdmin();
        _;
    }
    
    modifier onlyKeeper() {
        if (!hasRole(KEEPER_ROLE, msg.sender)) revert NotKeeper();
        _;
    }
    
    // ---------- Core Functions ----------
    
    /**
     * @dev Borrow stablecoins against gold collateral
     * @param amount Amount of stablecoin to borrow
     */
    function borrow(uint256 amount) 
        external 
        nonReentrant 
        whenNotPaused 
        onlyTreasury 
    {
        if (amount == 0) revert InvalidAmount();
        
        uint256 goldValue = _getGoldValue();
        uint256 newDebt = totalDebt + amount;
        
        // Enforce max LTV (25%)
        uint256 maxBorrow = (goldValue * maxLTV) / 100;
        if (newDebt > maxBorrow) revert ExceedsMaxLTV();
        
        // Enforce min collateral ratio (400%)
        uint256 newCollateralRatio = (goldValue * 100) / newDebt;
        if (newCollateralRatio < minCollateralRatio) revert BelowMinCollateralRatio();
        
        // Calculate fee (if any)
        uint256 fee = (amount * borrowingFee) / 10000;
        uint256 amountAfterFee = amount - fee;
        
        // Update state
        totalDebt = newDebt;
        totalFeesAccumulated += fee;
        lastBorrowTime = block.timestamp;
        totalBorrowEvents++;
        
        // Transfer stablecoin to treasury
        if (amountAfterFee > 0) {
            if (!stablecoin.transfer(msg.sender, amountAfterFee)) revert TransferFailed();
        }
        
        emit Borrowed(amount, fee, goldValue, (newDebt * 100) / goldValue);
    }
    
    /**
     * @dev Repay borrowed stablecoins
     * @param amount Amount to repay
     */
    function repay(uint256 amount) 
        external 
        nonReentrant 
        whenNotPaused 
        onlyTreasury 
    {
        if (amount == 0) revert InvalidAmount();
        if (amount > totalDebt) revert InsufficientDebt();
        
        // Transfer stablecoin from treasury
        if (!stablecoin.transferFrom(msg.sender, address(this), amount)) revert TransferFailed();
        
        totalDebt -= amount;
        totalRepayEvents++;
        
        emit Repaid(amount, totalDebt);
    }
    
    /**
     * @dev Liquidate the position (only if treasury fails to maintain ratio)
     * This is a safety mechanism - in normal operation, treasury keeps ratio healthy
     */
    function liquidate() external nonReentrant onlyKeeper {
        uint256 goldValue = _getGoldValue();
        uint256 currentLTV = (totalDebt * 100) / goldValue;
        
        // Only liquidate if LTV exceeds safe threshold
        if (currentLTV <= 80) return; // 80% LTV is liquidation trigger
        
        uint256 debtToCover = totalDebt;
        uint256 penalty = (debtToCover * liquidationPenalty) / 10000;
        uint256 goldToSell = _getGoldNeeded(debtToCover + penalty);
        
        // Withdraw gold from vault
        _withdrawGold(goldToSell);
        
        // Sell gold for stablecoins (via DEX)
        uint256 stablesReceived = _sellGoldForStables(goldToSell);
        
        if (stablesReceived >= debtToCover + penalty) {
            totalDebt = 0;
            uint256 surplus = stablesReceived - (debtToCover + penalty);
            if (surplus > 0) {
                stablecoin.transfer(msg.sender, surplus);
            }
        } else {
            // Partial liquidation
            totalDebt -= stablesReceived;
        }
        
        emit Liquidated(debtToCover, goldToSell, penalty);
    }
    
    // ---------- View Functions ----------
    
    function getHealthMetrics() external view returns (
        uint256 goldValueUSD,
        uint256 currentLTV,
        uint256 collateralRatio,
        uint256 maxBorrowAvailable,
        uint256 liquidationThreshold
    ) {
        goldValueUSD = _getGoldValue();
        if (totalDebt == 0) {
            return (goldValueUSD, 0, type(uint256).max, (goldValueUSD * maxLTV) / 100, 0);
        }
        
        currentLTV = (totalDebt * 100) / goldValueUSD;
        collateralRatio = (goldValueUSD * 100) / totalDebt;
        maxBorrowAvailable = ((goldValueUSD * maxLTV) / 100) - totalDebt;
        liquidationThreshold = (goldValueUSD * 80) / 100; // 80% LTV liquidation threshold
    }
    
    function _getGoldValue() internal view returns (uint256) {
        // Call GoldVault to get current gold value
        return IGoldVault(goldVault).getCurrentGoldValue();
    }
    
    function _getGoldNeeded(uint256 stableAmount) internal view returns (uint256) {
        uint256 goldPrice = _getGoldPrice();
        // Returns gold amount with 18 decimals
        return (stableAmount * 1e8) / goldPrice;
    }
    
    function _getGoldPrice() internal view returns (uint256) {
        (, int256 price, , uint256 updatedAt, ) = GOLD_ORACLE.latestRoundData();
        if (price <= 0) revert OracleFailed();
        if (updatedAt < block.timestamp - 2 hours) revert OracleFailed();
        return uint256(price);
    }
    
    function _withdrawGold(uint256 goldAmount) internal {
        // Withdraw from GoldVault for liquidation
        IGoldVault(goldVault).withdrawForBuyback(address(0), goldAmount);
    }
    
    function _sellGoldForStables(uint256 goldAmount) internal returns (uint256) {
        // Placeholder - integrate with DEX for gold to stable swap
        // In production, implement swap via Uniswap/Curve
        revert("DEX integration needed");
    }
    
    // ---------- Admin Functions ----------
    
    function setGoldVault(address _newVault) external onlyAdmin {
        require(_newVault != address(0), "Invalid vault");
        goldVault = _newVault;
        emit GoldVaultUpdated(_newVault);
    }
    
    function setMaxLTV(uint256 newLTV) external onlyAdmin {
        require(newLTV > 0 && newLTV <= 50, "LTV must be 1-50%");
        uint256 old = maxLTV;
        maxLTV = newLTV;
        emit ParametersUpdated("maxLTV", old, newLTV);
    }
    
    function setMinCollateralRatio(uint256 newRatio) external onlyAdmin {
        require(newRatio >= 200, "Min ratio must be >= 200%");
        uint256 old = minCollateralRatio;
        minCollateralRatio = newRatio;
        emit ParametersUpdated("minCollateralRatio", old, newRatio);
    }
    
    function setBorrowingFee(uint256 newFee) external onlyAdmin {
        require(newFee <= 500, "Fee cannot exceed 5%");
        uint256 old = borrowingFee;
        borrowingFee = newFee;
        emit ParametersUpdated("borrowingFee", old, newFee);
    }
    
    function setLiquidationPenalty(uint256 newPenalty) external onlyAdmin {
        require(newPenalty <= 1000, "Penalty cannot exceed 10%");
        uint256 old = liquidationPenalty;
        liquidationPenalty = newPenalty;
        emit ParametersUpdated("liquidationPenalty", old, newPenalty);
    }
    
    function withdrawFees() external onlyAdmin {
        uint256 amount = totalFeesAccumulated;
        if (amount == 0) return;
        totalFeesAccumulated = 0;
