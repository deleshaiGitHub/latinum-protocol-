Bridge Handshake Script - Ready for Deployment

The Solana base looks solid. Here's the SetPeer script to link your Base Sepolia Hub with the Solana program.

📜 The Script
Create a new file scripts/setSolanaPeer.js in your project:

javascript
const hre = require("hardhat");
const { ethers } = require("ethers");

// ===== CONFIGURATION =====
const HUB_ADDRESS = "0x41ab2B71D5d4E6b68eeBd1BA2272eD50D436f105";
const SOLANA_PROGRAM_ID = "DbY627K1p6y1eXGqXe4UTm7o8aWMywu2RPZ1Vm5nTfqW";
const SOLANA_EID = 40245; // LayerZero Devnet EID for Solana

async function main() {
  console.log("🔗 Connecting Base Sepolia Hub to Solana Program...");
  
  // Get the signer
  const [signer] = await hre.ethers.getSigners();
  console.log("Using address:", signer.address);
  
  // Attach to the Hub contract
  const hub = await hre.ethers.getContractAt("LatinumPressHub", HUB_ADDRESS, signer);
  
  // Convert Solana Program ID to bytes32
  // Remove '0x' prefix and pad to 32 bytes
  const solanaProgramIdHex = Buffer.from(SOLANA_PROGRAM_ID, 'base58').toString('hex');
  const solanaProgramIdBytes32 = '0x' + solanaProgramIdHex.padStart(64, '0');
  
  console.log("Solana Program ID (as bytes32):", solanaProgramIdBytes32);
  
  // Call setPeer on the Hub
  console.log(`\nSetting peer for chain ID ${SOLANA_EID}...`);
  const tx = await hub.setPeer(
    SOLANA_EID,
    solanaProgramIdBytes32,
    { gasLimit: 300000 }
  );
  
  console.log("Transaction sent:", tx.hash);
  await tx.wait();
  console.log("✅ Peer set successfully!");
  
  // Verify the peer was set
  const peer = await hub.peers(SOLANA_EID);
  console.log("Confirmed peer:", peer);
}

main()
  .then(() => process.exit(0))
  .catch((error) => {
    console.error(error);
    process.exit(1);
  });
🚀 How to Run
Save the script to scripts/setSolanaPeer.js

Run it with Hardhat:

bash
npx hardhat run scripts/setSolanaPeer.js --network baseSepolia
