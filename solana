import * as anchor from "@coral-xyz/anchor";
import { Program } from "@coral-xyz/anchor";
import { PublicKey, SystemProgram, SYSVAR_RENT_PUBKEY } from "@solana/web3.js";
import { TOKEN_PROGRAM_ID, ASSOCIATED_TOKEN_PROGRAM_ID } from "@solana/spl-token";
import { LatinumRemotePress } from "../target/types/latinum_protocol";

// ===== CONSTANTS =====
const BASE_HUB_ADDRESS = new PublicKey("0x41ab2B71D5d4E6b68eeBd1BA2272eD50D436f105"); // Base Sepolia Hub
const USDC_MINT_DEVNET = new PublicKey("4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"); // Devnet USDC
const LZ_ENDPOINT = new PublicKey("76y77prYMDv2Ao5Q5j7jG1CnTRVvzCv3pQJ7PvP3vJk"); // LayerZero Devnet

async function main() {
    console.log("🚀 Initializing Latinum Protocol on Solana Devnet...");

    // Set up provider
    const provider = anchor.AnchorProvider.env();
    anchor.setProvider(provider);
    console.log("✅ Provider set up. Wallet:", provider.wallet.publicKey.toString());

    // Load program
    const program = anchor.workspace.LatinumProtocol as Program<LatinumRemotePress>;
    console.log("✅ Program loaded. Program ID:", program.programId.toString());

    // Derive PDA addresses
    const [solanaTreasuryPDA, solanaTreasuryBump] = PublicKey.findProgramAddressSync(
        [Buffer.from("solana_treasury")],
        program.programId
    );

    const [nagusVaultPDA, nagusVaultBump] = PublicKey.findProgramAddressSync(
        [Buffer.from("nagus_vault_solana")],
        program.programId
    );

    console.log("📊 Derived PDAs:");
    console.log("  - Solana Treasury:", solanaTreasuryPDA.toString());
    console.log("  - Nagus Vault:", nagusVaultPDA.toString());

    try {
        // Step 1: Initialize treasuries
        console.log("\n📝 Step 1: Initializing treasuries...");
        
        const initTx = await program.methods
            .initialize(
                USDC_MINT_DEVNET,
                BASE_HUB_ADDRESS
            )
            .accounts({
                admin: provider.wallet.publicKey,
                solanaTreasury: solanaTreasuryPDA,
                nagusVault: nagusVaultPDA,
                usdcMint: USDC_MINT_DEVNET,
                baseHubAddress: BASE_HUB_ADDRESS,
                lzEndpoint: LZ_ENDPOINT,
                tokenProgram: TOKEN_PROGRAM_ID,
                systemProgram: SystemProgram.programId,
                rent: SYSVAR_RENT_PUBKEY,
            })
            .signers([])
            .rpc();

        console.log("✅ Treasuries initialized!");
        console.log("   Tx Signature:", initTx);

        // Step 2: Set trusted peer (Base Sepolia Hub)
        console.log("\n📝 Step 2: Setting trusted peer (Base Sepolia Hub)...");

        // Convert Base Hub address to bytes32 (left-padded with zeros)
        const baseHubBytes32 = Buffer.from(
            BASE_HUB_ADDRESS.toBytes().slice(0, 20) // Take first 20 bytes
        );
        // Left-pad with zeros to 32 bytes
        const baseHubPadded = Buffer.concat([
            Buffer.alloc(12, 0), // 12 bytes of zeros
            baseHubBytes32        // 20 bytes of address
        ]);

        const setPeerTx = await program.methods
            .setTrustedPeer(
                40245, // Base Sepolia EID
                Array.from(baseHubPadded) // Convert to number array for Anchor
            )
            .accounts({
                admin: provider.wallet.publicKey,
                systemProgram: SystemProgram.programId,
            })
            .signers([])
            .rpc();

        console.log("✅ Trusted peer set!");
        console.log("   Tx Signature:", setPeerTx);

        console.log("\n🎉 ALL DONE! Solana program is now fully configured.");
        console.log("\n📋 Summary:");
        console.log("   Program ID:", program.programId.toString());
        console.log("   Solana Treasury:", solanaTreasuryPDA.toString());
        console.log("   Nagus Vault:", nagusVaultPDA.toString());
        console.log("   USDC Mint:", USDC_MINT_DEVNET.toString());
        console.log("   Base Hub (trusted peer):", BASE_HUB_ADDRESS.toString());

    } catch (error) {
        console.error("\n❌ Error during initialization:", error);
        if (error.logs) {
            console.log("\n📝 Program Logs:");
            error.logs.forEach(log => console.log("   ", log));
        }
    }
}

console.log("🔥 Starting Latinum Protocol initialization...");
main().then(
    () => process.exit(0),
    (err) => {
        console.error(err);
        process.exit(1);
    }
);
